[Unit]
Description=MOD-HOST: LV2 plugin server
After=jack2.service
Requires=jack2.service

[Service]
# MOD-UI's mod-host is plugin-hostd on ports 5555 and 5556, started by
# sbin/plugin-hostd-start.sh, which returns once the daemon is ready. The daemon
# stays in the unit's control group; stopping the unit sends it SIGTERM, which
# stops every worker and then the daemon.
Type=forking
RemainAfterExit=true
Environment=LV2_PATH=#LV2_PATH#
Environment=ZYNTHIAN_CONFIG_DIR=#ZYNTHIAN_CONFIG_DIR#
Environment=ZYNTHIAN_SYS_DIR=#ZYNTHIAN_SYS_DIR#
ExecStart=#ZYNTHIAN_SYS_DIR#/sbin/plugin-hostd-start.sh 5555 5556
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
